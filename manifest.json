{
    "manifest_version": 3,
    "name": "Auto Refresh Extension",
    "description": "Automatically refresh a page with customizable settings.",
    "version": "1.2",
    "permissions": [
      "tabs",
      "activeTab",
      "scripting",
      "storage"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "icons": {
      "48": "icon.png"
    },
    "content_scripts": [
      {
        "matches": [
          "http://*/*",
          "https://*/*"
        ],
        "js": ["content.js"]
      }
    ]
  }
  